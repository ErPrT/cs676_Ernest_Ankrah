Exercise 1 Linera regression (01_lr.py)


def mse_gradient(X, y, beta):
    """
    Compute the gradient of Mean Squared Error with respect to beta.
    Loss: (1 / N) * ||X @ beta - y||^2
    """
    N = len(y)
    y_pred = X @ beta
    return (2 / N) * (X.T @ (y_pred - y))

# Gradient descent loop
for _ in range(n_iter):
    grad = mse_gradient(X, y, beta)
    beta = beta - lr * grad



Exercise 2 Logistic regression (02_logreg.py)

def sigmoid(z):
    """
    Compute the logistic sigmoid function with numerical stability clipping.
    """
    z_clipped = np.clip(z, -500, 500)
    return 1.0 / (1.0 + np.exp(-z_clipped))

# Gradient descent loop
for _ in range(n_iter):
    p_pred = sigmoid(X @ beta)
    grad = (1 / len(y)) * (X.T @ (p_pred - y))
    beta = beta - lr * grad


Exercise 3 K-Fold Cross Validation (03_cv.py)

def make_folds(n_samples, k, shuffle=True, seed=None):
    """
    Partition sample indices into k roughly equal disjoint splits.
    """
    indices = np.arange(n_samples)
    if shuffle:
        rng = np.random.default_rng(seed)
        rng.shuffle(indices)
    return np.array_split(indices, k)

# K-fold evaluation loop
scores = []
for i in range(k):
    test_idx = folds[i]
    train_idx = np.concatenate([folds[j] for j in range(k) if j != i])
    
    X_train, y_train = X[train_idx], y[train_idx]
    X_test, y_test = X[test_idx], y[test_idx]
    
    beta = fit(X_train, y_train)
    y_pred = X_test @ beta
    scores.append(metric(y_test, y_pred))


Exercise 4 Decison Tree Split search (04_tree.py)

def find_best_split(X, y):
    """
    Find the feature index and threshold value that maximize impurity reduction.
    """
    best_gain = -np.inf
    best_feat, best_thresh = None, None
    n = len(y)
    parent_impurity = np.var(y)
    
    n_features = X.shape[1]
    for feat_idx in range(n_features):
        thresholds = np.unique(X[:, feat_idx])
        for thresh in thresholds:
            left_mask = X[:, feat_idx] <= thresh
            right_mask = ~left_mask
            
            n_l, n_r = np.sum(left_mask), np.sum(right_mask)
            if n_l == 0 or n_r == 0:
                continue
                
            child_impurity = (n_l / n) * np.var(y[left_mask]) + (n_r / n) * np.var(y[right_mask])
            gain = parent_impurity - child_impurity
            
            if gain > best_gain:
                best_gain = gain
                best_feat = feat_idx
                best_thresh = thresh
                
    return best_feat, best_thresh



Exercise 5 K-Means Clustering(05_kmeans.py)

def assign_clusters(X, centroids):
    """
    Assign each data point to the index of the nearest centroid.
    """
    distances = np.linalg.norm(X[:, np.newaxis, :] - centroids[np.newaxis, :, :], axis=2)
    return np.argmin(distances, axis=1)

def update_centroids(X, labels, k):
    """
    Compute new centroids as the mean of assigned data points.
    """
    centroids = np.zeros((k, X.shape[1]))
    for j in range(k):
        cluster_points = X[labels == j]
        if len(cluster_points) > 0:
            centroids[j] = cluster_points.mean(axis=0)
    return centroids

# K-means convergence loop
for _ in range(max_iter):
    labels = assign_clusters(X, centroids)
    new_centroids = update_centroids(X, labels, k)
    
    if np.allclose(centroids, new_centroids):
        break
    centroids = new_centroids
