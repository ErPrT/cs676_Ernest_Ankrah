def mse_gradient(X, y, beta):
    """
    Compute the gradient of Mean Squared Error with respect to beta.
    Loss: (1 / N) * ||X @ beta - y||^2
    """
    N = len(y)
    y_pred = X @ beta
    return (2 / N) * (X.T @ (y_pred - y))

# Gradient descent loop
for _ in range(n_iter):
    grad = mse_gradient(X, y, beta)
    beta = beta - lr * grad

